{
  "name": "harmonia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sing a melody, get intelligent vocal harmonies, sheet music, and real-time adaptive live harmonization.",
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:sample": "node scripts/generate-sample.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tonejs/midi": "^2.0.28",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
